def get_chat_owner_id(
    x_chat_owner_id: str | None,
) -> str:

    owner_id = (
        x_chat_owner_id or ""
    ).strip()

    if not owner_id:
        raise HTTPException(
            status_code=400,
            detail="X-Chat-Owner-ID is required.",
        )

    if len(owner_id) > 100:
        raise HTTPException(
            status_code=400,
            detail="Invalid chat owner ID.",
        )

    return owner_id


@lru_cache(maxsize=2)
def get_conversation_manager(
    document_id: str,
    collection_name: str,
) -> ConversationManager:

    return ConversationManager()

@lru_cache(maxsize=2)
def get_answer_service(
    document_id: str,
    collection_name: str,
) -> RescueAnswerService:

    return RescueAnswerService(
        collection_name=collection_name,
    )


def load_conversation_manager() -> ConversationManager:

    active_document = (
        document_manager.get_active_document()
    )

    collection_name = active_document.get(
        "collection_name"
    )

    if not collection_name:
        raise HTTPException(
            status_code=503,
            detail=(
                "Active prospectus has no "
                "Qdrant collection configured."
            ),
        )

    return get_conversation_manager(
        active_document["document_id"],
        collection_name,
    )


@router.get("/chats")
def list_chats(
    x_chat_owner_id: str | None = Header(
        default=None
    ),
):

    owner_id = get_chat_owner_id(
        x_chat_owner_id
    )

    return {
        "chats": chat_service.list_chats(
            browser_id=owner_id,
        )
    }


@router.post("/chats")
def create_chat(
    x_chat_owner_id: str | None = Header(
        default=None
    ),
):

    owner_id = get_chat_owner_id(
        x_chat_owner_id
    )

    chat = chat_service.create_chat(
        browser_id=owner_id,
    )

    session_manager.get_session(
         chat["id"],
    )

    return chat

