@router.get("/chats/{chat_id}/messages")
def get_messages(
    chat_id: str,
    x_chat_owner_id: str | None = Header(
        default=None
    ),
):
    owner_id = get_chat_owner_id(
        x_chat_owner_id
    )

    chat, messages = (
        chat_service.get_chat_with_messages(
            browser_id=owner_id,
            chat_id=chat_id,
        )
    )

    if chat is None:
        raise HTTPException(
            status_code=404,
            detail="Chat not found.",
        )

    return {
        "messages": messages,
    }


